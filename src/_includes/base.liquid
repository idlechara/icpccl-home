<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- capture pageTitle %}{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% if contests.next %} · {{ contests.next.name }}{% endif %}{% endif %}{% endcapture %}
  {%- capture pageDescription %}{% if description %}{{ description }}{% else %}ICPC Chile: TCP y Regional ICPC.{% for contest in contests.upcoming %} {{ contest.name }}: {{ contest.dates }}.{% endfor %} Inscripción, agenda, preguntas frecuentes y equipo.{% endif %}{% endcapture %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% unless site.production %}<meta name="robots" content="noindex, nofollow">{% endunless %}
  <link rel="icon" type="image/png" href="/img/icpc-logo.png">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_CL">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/img/icpc-logo.png">
  <meta name="twitter:card" content="summary">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
  {% if page.url == "/faq/" %}<script type="application/ld+json">{{ faq.jsonLd }}</script>{% elsif page.url == "/faq/tecnica/" %}<script type="application/ld+json">{{ faqTecnica.jsonLd }}</script>{% endif %}
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <style>
/* Palette and type taken from icpc.global: slate ink, ICPC blue, navy and gold */
:root {
  color-scheme: light;
  --ink: #0f172a;
  --muted: #64748b;
  --bg: #f8fafc;
  --surface: #ffffff;
  --border: #e2e8f0;
  --primary: #0061cc;
  --primary-dark: #003f8a;
  --navy: #164173;
  --gold: #fdbc1e;
  --gold-soft: #fff8e6;
  --nav-height: 4rem;
  --radius: 12px;
  --shadow: 0 1px 3px rgba(15, 23, 42, 0.06), 0 8px 24px rgba(15, 23, 42, 0.05);
  --font-display: Roboto, system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  font-family: Roboto, system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

/* The hidden attribute always wins over component display rules (e.g. display: flex) */
[hidden] {
  display: none !important;
}

html {
  scroll-behavior: smooth;
  /* --nav-offset: the nav's real height, which grows when it wraps (set by the script below) */
  scroll-padding-top: calc(var(--nav-offset, var(--nav-height)) + 1rem);
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.5;
}

a {
  color: var(--primary);
}

a:hover {
  color: var(--primary-dark);
}

h1,
h2 {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.02em;
}

.nav {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: var(--nav-height);
  padding: 0.5rem clamp(1rem, 3vw, 3rem);
  background: var(--navy);
  border-bottom: 3px solid var(--gold);
}

.nav__brand {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  color: #fff;
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}

.nav__brand:hover {
  color: #fff;
}

.nav__brand img {
  height: 44px;
  width: auto;
}

.nav__links {
  flex: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1.5rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav__links a {
  display: inline-block;
  padding: 0.35rem 0;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  font-weight: 500;
}

.nav__links a:hover,
.nav__links a[aria-current="page"] {
  color: #fff;
}

.nav__links a[aria-current="page"] {
  box-shadow: inset 0 -2px 0 var(--gold);
}

/* Search in the nav (Pagefind UI); results open as a dropdown under the input */
.nav__search {
  --pagefind-ui-scale: 0.8;
  --pagefind-ui-primary: var(--primary);
  --pagefind-ui-text: var(--ink);
  --pagefind-ui-background: var(--surface);
  --pagefind-ui-border: var(--border);
  --pagefind-ui-tag: #f1f5f9;
  --pagefind-ui-border-width: 1px;
  --pagefind-ui-font: var(--font-display);
  flex: 0 1 20rem;
  min-width: 9rem;
  margin: 0 auto;
}

.nav__search .pagefind-ui__search-input {
  height: 2.5rem;
  padding: 0 4.5rem 0 2.4rem;
  border-color: transparent;
  font-size: 0.95rem;
  font-weight: 400;
}

.nav__search .pagefind-ui__search-input:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 1px;
}

.nav__search .pagefind-ui__search-input::placeholder {
  opacity: 0.6;
}

.nav__search .pagefind-ui__form::before {
  top: 0.8rem;
  left: 0.85rem;
}

.nav__search .pagefind-ui__search-clear {
  top: 3px;
  height: calc(2.5rem - 6px);
}

.nav__search .pagefind-ui__drawer {
  position: absolute;
  top: calc(100% + 0.6rem);
  left: 50%;
  transform: translateX(-50%);
  width: min(34rem, calc(100vw - 2rem));
  max-height: min(70vh, 40rem);
  overflow-y: auto;
  padding: 0 1.25rem 1rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.2);
}

.nav__search:not(.is-open) .pagefind-ui__drawer,
.nav__search .pagefind-ui__drawer:empty {
  display: none;
}

.page {
  min-height: calc(100vh - var(--nav-height));
  display: flex;
  flex-direction: column;
  max-width: 76rem;
  margin: 0 auto;
  padding: 2rem clamp(1rem, 3vw, 3rem) 3rem;
}

main {
  flex: 1;
}

/* Hero (home) */
.hero {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  padding: clamp(2rem, 4vw, 3rem);
  margin-bottom: 3rem;
  color: #fff;
  background: linear-gradient(135deg, var(--navy) 0%, #0b4f9e 60%, var(--primary) 100%);
  border-radius: calc(var(--radius) + 4px);
  box-shadow: var(--shadow);
}

.hero__content h1 {
  font-size: clamp(2.4rem, 4vw, 3.4rem);
  line-height: 1.1;
  margin: 0 0 1rem;
}

.hero__lead {
  line-height: 1.7;
  margin: 0 0 1.5rem;
}

.hero .hero__lead {
  color: rgba(255, 255, 255, 0.85);
}

.hero a:not(.btn) {
  color: var(--gold);
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.25em;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--primary);
  margin: 0 0 0.5rem;
}

.hero .eyebrow {
  color: var(--gold);
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1.75rem;
}

.btn {
  display: inline-block;
  padding: 0.75rem 1.4rem;
  border-radius: 8px;
  border: 1px solid transparent;
  font: inherit;
  font-weight: 500;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.btn.primary {
  background: var(--primary);
  color: #fff;
}

.btn.primary:hover {
  background: var(--primary-dark);
  color: #fff;
}

.btn.ghost {
  background: var(--surface);
  border-color: var(--border);
  color: var(--ink);
}

.btn.ghost:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.hero .btn.primary {
  background: var(--gold);
  color: var(--navy);
}

.hero .btn.primary:hover {
  background: #ffcd4d;
  color: var(--navy);
}

.hero .btn.ghost {
  background: transparent;
  border-color: rgba(255, 255, 255, 0.5);
  color: #fff;
}

.hero .btn.ghost:hover {
  border-color: #fff;
  background: rgba(255, 255, 255, 0.08);
}

.hero__meta {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.hero__meta span,
.fact span {
  display: block;
  font-size: 0.72rem;
  font-weight: 500;
  color: var(--muted);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.hero__meta span {
  color: rgba(255, 255, 255, 0.7);
}

.hero__meta strong {
  font-size: 1.05rem;
  font-weight: 500;
}

.hero__card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.9rem;
}

.card-label {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-transform: uppercase;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.25em;
  color: #fff;
  margin: 0;
}

.card-label::before {
  content: "";
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 0 4px rgba(253, 188, 30, 0.25);
}

.countdown {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  background: rgba(6, 24, 54, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 16px;
  overflow: hidden;
}

.countdown__item {
  padding: 1.25rem 0.25rem 1rem;
  text-align: center;
  color: #fff;
}

.countdown__item + .countdown__item {
  border-left: 1px solid rgba(255, 255, 255, 0.14);
}

.countdown__item span {
  display: block;
  font-size: clamp(1.8rem, 5vw, 2.8rem);
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.countdown__item small {
  display: block;
  margin-top: 0.55rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.62rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.75);
}

/* Registration status and link, below the countdown */
.hero-registration {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1rem;
  padding: 0.85rem 1rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-registration__status {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  margin: 0;
  font-weight: 500;
  color: #fff;
}

.hero-registration__dot {
  width: 0.6rem;
  height: 0.6rem;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  flex: none;
}

.hero-registration--open .hero-registration__dot {
  background: #4ade80;
  box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.25);
}

.hero-registration--closed .hero-registration__dot {
  background: #f87171;
}

.hero-registration .btn {
  padding: 0.55rem 1.1rem;
}

.card-link-inline {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 0.45rem;
  padding: 0.5rem 1rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #fff;
  font-weight: 500;
  text-decoration: none;
}

.hero a.card-link-inline:hover {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.card-link-inline svg {
  width: 1.1rem;
  height: 1.1rem;
  fill: var(--gold);
  flex: none;
}

.card-foot {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
}

/* Sections */
.page-header {
  margin-bottom: 2.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
}

.page-header h1 {
  font-size: clamp(2.2rem, 4vw, 3.2rem);
  line-height: 1.1;
  color: var(--navy);
  margin: 0 0 0.75rem;
}

.page-header .hero__lead {
  color: var(--muted);
  margin: 0;
  max-width: 48rem;
}

.page-contact {
  display: inline-block;
  margin: 1rem 0 0;
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  background: var(--surface);
  border: 1px solid var(--border);
  font-size: 0.9rem;
  color: var(--muted);
}

.page-contact a {
  font-weight: 500;
}

.block {
  margin-bottom: 3.5rem;
}

.block > h2 {
  font-size: clamp(1.6rem, 3vw, 2.1rem);
  color: var(--navy);
  margin: 0 0 0.75rem;
}

.block__lead {
  color: var(--muted);
  line-height: 1.65;
  margin: 0 0 1.5rem;
  max-width: 48rem;
}

/* Contest description and status box span the full content width, like the cards below */
.block__lead--wide {
  max-width: none;
}

.block__lead > p {
  margin: 0 0 0.75rem;
}

.block__lead > :last-child {
  margin-bottom: 0;
}

.panel {
  background: var(--surface);
  padding: 1.5rem;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.25rem;
}

.grid + .grid {
  margin-top: 1.25rem;
}

.fact {
  border-top: 3px solid var(--gold);
}

.fact strong {
  display: block;
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--navy);
  margin: 0.5rem 0 0.35rem;
}

.fact p {
  margin: 0;
  color: var(--muted);
  line-height: 1.5;
}

.contest-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  margin: -0.25rem 0 1.25rem;
  color: var(--ink);
  font-weight: 500;
}

.contest-meta span {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.hero__place {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

/* Venue logo, with the countdown links beside it (vertically centered). The logo
   grows up to 15rem wide and shrinks first on narrow screens. White logos
   (placeLogoWhite) go bare on the dark hero; others get a white background. */
.hero__venue {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem 1.25rem;
  margin-top: 0.5rem;
}

.hero__venue:not(:has(*)) {
  display: none;
}

/* Centered in the space beside the logo */
.hero__venue .card-link-inline {
  align-self: center;
  flex: none;
  margin-inline: auto;
}

.hero__logo {
  flex: 1 1 8rem;
  min-width: 0;
  max-width: 15rem;
  height: auto;
  object-fit: contain;
  padding: 0.4rem;
  border-radius: 8px;
  background: #fff;
}

.hero__logo.is-white {
  padding: 0;
  border-radius: 0;  /* rounded corners would clip logos that touch the edges */
  background: none;
}

.contest-meta svg {
  width: 1.1rem;
  height: 1.1rem;
  fill: var(--primary);
  flex: none;
}

.notice {
  display: flex;
  gap: 0.75rem;
  align-items: baseline;
  margin: 0 0 1.5rem;
  padding: 1rem 1.25rem;
  border-radius: 10px;
  border: 1px solid var(--gold);
  border-left-width: 5px;
  background: var(--gold-soft);
  line-height: 1.5;
  max-width: 48rem;
}

/* Notice with text and buttons stacked; spans the full content width */
.notice--stack {
  max-width: none;
  flex-direction: column;
  align-items: stretch;
  gap: 0.9rem;
}

.notice--stack p {
  margin: 0;
}

.notice--done {
  border-color: var(--border);
  background: #f1f5f9;
}

.notice__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.notice__actions .btn {
  padding: 0.55rem 1.1rem;
  font-size: 0.92rem;
}

.notice strong {
  color: var(--navy);
  white-space: nowrap;
}

.schedule {
  width: 100%;
  border-collapse: collapse;
}

.schedule td {
  padding: 0.55rem 1rem 0.55rem 0;
  border-bottom: 1px solid var(--border);
  color: var(--muted);
  vertical-align: top;
}

.schedule tr:last-child td {
  border-bottom: 0;
}

.schedule td:first-child {
  white-space: nowrap;
  color: var(--ink);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.schedule tr.is-main td {
  color: var(--primary);
  font-weight: 700;
}

.block__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.panel h3 {
  margin-top: 0;
  color: var(--navy);
}

.panel ul {
  padding-left: 1rem;
  list-style: none;
  margin: 0;
}

.panel li,
.panel p {
  color: var(--muted);
  line-height: 1.6;
}

.panel ul > li::before,
.faq__answer ul > li::before {
  content: "•";
  color: var(--primary);
  display: inline-block;
  width: 1rem;
  margin-left: -1rem;
}

.card-link {
  display: block;
  color: inherit;
  text-decoration: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
}

.card-link:hover {
  color: inherit;
  border-color: var(--primary);
  transform: translateY(-2px);
}

.card-link h3 {
  margin: 0.5rem 0;
}

.card-link p {
  margin: 0.25rem 0 0;
}

.block__subtitle {
  font-size: clamp(1.3rem, 2.5vw, 1.6rem);
  color: var(--navy);
  margin: 2.5rem 0 1rem;
}

/* Everyone who has been part of ICPC Chile, below the current team on /equipo/ */
.team-history {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 0.75rem 2rem;
}

.team-history__person {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border);
}

.team-history__role {
  color: var(--muted);
  font-size: 0.95rem;
}

.sponsors {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* One line per sponsor `row`: centered, cards stretch to fill it */
.sponsors__row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

.sponsor {
  flex: 1 1 200px;
  display: grid;
  place-items: center;
  min-height: 110px;
  padding: 1rem 1.25rem;
  text-decoration: none;
}

a.sponsor:hover {
  border-color: var(--primary);
}

.sponsor img {
  max-width: 100%;
  max-height: 70px;
  object-fit: contain;
}

.sponsor__name {
  font-weight: 500;
  color: var(--muted);
  text-align: center;
}

.past-contest h3 {
  margin: 0.5rem 0;
}

.past-contest p {
  margin: 0.25rem 0 0;
}

.past-contest__status {
  display: inline-block;
  margin-top: 0.75rem !important;
  padding: 0.1rem 0.6rem;
  border-radius: 999px;
  background: #f1f5f9;
  border: 1px solid var(--border);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--muted) !important;
}

.past-contest__links {
  display: flex !important;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1rem !important;
}

.past-contest__links .btn {
  padding: 0.45rem 1rem;
  font-size: 0.9rem;
}

.card-link__kind {
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--primary);
}

/* FAQ */
.faq {
  display: grid;
  grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
  gap: 2rem;
  align-items: start;
}

.faq__index {
  position: sticky;
  top: calc(var(--nav-offset, var(--nav-height)) + 1rem);
  font-size: 0.9rem;
}

.faq__index p {
  margin: 1.25rem 0 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--navy);
}

.faq__index p:first-child {
  margin-top: 0;
}

.faq__index ul {
  list-style: none;
  margin: 0;
  padding: 0;
  border-left: 2px solid var(--border);
}

.faq__index a {
  display: block;
  padding: 0.3rem 0 0.3rem 0.85rem;
  margin-left: -2px;
  border-left: 2px solid transparent;
  color: var(--muted);
  text-decoration: none;
}

.faq__index a:hover {
  color: var(--primary);
  border-left-color: var(--primary);
}

.faq__group + .faq__group {
  margin-top: 2.5rem;
}

.faq__group > h3 {
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.75rem;
  color: var(--primary);
  margin: 0 0 1rem;
}

.faq__section {
  padding: 0.5rem 1.5rem;
}

.faq__section + .faq__section {
  margin-top: 1.25rem;
}

.faq__section h4 {
  font-size: 1.15rem;
  color: var(--navy);
  margin: 1rem 0 0.5rem;
}

.faq details {
  border-top: 1px solid var(--border);
}

.faq summary {
  position: relative;
  list-style: none;
  cursor: pointer;
  padding: 1rem 2.25rem 1rem 0;
  font-weight: 500;
  line-height: 1.4;
}

/* The question is a heading so search results can link to it */
.faq summary h5 {
  margin: 0;
  font: inherit;
}

.faq summary::-webkit-details-marker {
  display: none;
}

.faq summary::after {
  content: "+";
  position: absolute;
  right: 0.25rem;
  top: 0.8rem;
  font-size: 1.4rem;
  line-height: 1;
  color: var(--primary);
  transition: transform 0.2s ease;
}

.faq details[open] summary::after {
  transform: rotate(45deg);
}

.faq summary:hover,
.faq details[open] summary {
  color: var(--primary);
}

.faq__answer {
  color: #334155;
  line-height: 1.65;
  padding-bottom: 1rem;
}

.faq__answer > :first-child {
  margin-top: 0;
}

.faq__answer ul {
  list-style: none;
  padding-left: 1rem;
}

.faq__answer strong {
  color: var(--ink);
}

.faq__answer table,
.faq__intro table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

/* Cells wrap; long words (e.g. URLs) break instead of widening the table */
.faq__answer th,
.faq__answer td,
.faq__intro th,
.faq__intro td {
  text-align: left;
  vertical-align: top;
  padding: 0.6rem 1rem 0.6rem 0;
  border-bottom: 1px solid var(--border);
  overflow-wrap: anywhere;
}

.faq__answer td:first-child,
.faq__intro td:first-child {
  min-width: 6rem;
}

.faq__answer th,
.faq__intro th {
  color: var(--ink);
  white-space: nowrap;
}

.faq__answer tr:last-child td,
.faq__intro tr:last-child td {
  border-bottom: 0;
}

.faq__answer .swatch {
  white-space: nowrap;
}

.faq__intro {
  color: #334155;
  line-height: 1.65;
  margin-bottom: 1rem;
}

.faq__intro > :first-child {
  margin-top: 0;
}

.faq__intro ul {
  list-style: none;
  padding-left: 1rem;
}

.faq__intro li {
  margin-bottom: 0.4rem;
}

.faq__intro ul > li::before {
  content: "•";
  color: var(--primary);
  display: inline-block;
  width: 1rem;
  margin-left: -1rem;
}

/* Numbered lists keep their numbers (no bullet), in the accent color */
.panel ol,
.faq__answer ol,
.faq__intro ol {
  padding-left: 1.5rem;
}

.panel ol > li,
.faq__answer ol > li,
.faq__intro ol > li {
  padding-left: 0.25rem;
}

.panel ol > li + li,
.faq__answer ol > li + li,
.faq__intro ol > li + li {
  margin-top: 0.35rem;
}

.panel ol > li::marker,
.faq__answer ol > li::marker,
.faq__intro ol > li::marker {
  color: var(--primary);
  font-weight: 700;
}

code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.88em;
  background: #f1f5f9;
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0.1em 0.35em;
}

.swatch {
  display: inline-flex;
  align-items: center;
  gap: 0.45em;
}

.swatch__chip {
  display: inline-block;
  width: 1.1em;
  height: 1.1em;
  border-radius: 50%;
  border: 1px solid rgba(15, 23, 42, 0.25);
}

pre.mermaid {
  margin: 1rem 0 0;
  padding: 1rem;
  overflow-x: auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 0.8rem;
  color: var(--muted);
  text-align: center;
}

pre.mermaid svg {
  max-width: 100%;
  height: auto;
}

.faq__more {
  margin-top: 1.5rem;
  color: var(--muted);
}

/* Equipo */
.team {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* One line per `row` in team.js, centered so short rows don't hug the left */
.team__row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1.5rem;
}

.member {
  flex: 0 1 250px;
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}

.member__photo {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  object-position: 50% 15%;
  border-bottom: 4px solid var(--gold);
}

.member__media {
  position: relative;
}

.member__media--tip {
  cursor: help;
}

.member__media--tip:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: -3px;
}

/* Small badge that tells the card has a tooltip */
.member__media--tip::after {
  content: "i";
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  width: 1.6rem;
  height: 1.6rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--gold);
  color: var(--navy);
  font-weight: 700;
  font-size: 0.85rem;
  font-style: italic;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.25);
  transition: opacity 0.2s ease;
}

.member__tooltip {
  position: absolute;
  left: 0.75rem;
  right: 0.75rem;
  bottom: 1rem;
  padding: 0.65rem 0.85rem;
  border-radius: 10px;
  background: rgba(22, 65, 115, 0.94);
  color: #fff;
  font-size: 0.88rem;
  line-height: 1.45;
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.3);
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
  pointer-events: none;
}

.member__tooltip-line {
  display: block;
}

.member__tooltip-line + .member__tooltip-line {
  margin-top: 0.3rem;
}

.member__media--tip:hover .member__tooltip,
.member__media--tip:focus .member__tooltip {
  opacity: 1;
  transform: none;
}

.member__media--tip:hover::after,
.member__media--tip:focus::after {
  opacity: 0;
}

.member__photo--empty {
  display: grid;
  place-items: center;
  background: linear-gradient(160deg, #eef2f7, #dde5ef);
}

.member__photo--empty svg {
  width: 45%;
  height: 45%;
  fill: #b8c4d4;
}

.member__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 1.25rem 1.5rem 1.5rem;
}

.member h3 {
  margin: 0 0 0.35rem;
  font-size: 1.25rem;
}

.member__role {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  font-weight: 500;
  line-height: 1.5;
  color: var(--primary);
  margin: 0.15rem 0 0;
}

.member__role {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3rem 0.4rem;
}

.chip {
  display: inline-block;
  padding: 0.1rem 0.5rem;
  border-radius: 999px;
  border: 1px solid;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.5;
  text-transform: uppercase;
  white-space: nowrap;
}

.chip--tcp {
  background: var(--gold-soft);
  border-color: var(--gold);
  color: #7a4f00;
}

.chip--icpc {
  background: #e8f1fc;
  border-color: #b7d3f5;
  color: var(--primary-dark);
}

.team-filter {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.team-filter button {
  padding: 0.45rem 1.1rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  font-weight: 500;
  cursor: pointer;
}

.team-filter button:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.team-filter button[aria-pressed="true"] {
  background: var(--navy);
  border-color: var(--navy);
  color: #fff;
}

.team-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.5rem 1.5rem;
  margin: 0 0 1.75rem;
  font-size: 0.85rem;
  color: var(--muted);
}

.team-legend > span {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.member p.member__topics {
  margin: 0.85rem 0 0;
}

/* Contact links: an icon per channel instead of bullets */
.member__links {
  display: grid;
  gap: 0.4rem;
  margin: auto 0 0;
  padding: 1rem 0 0;
  list-style: none;
  font-size: 0.9rem;
}

.panel .member__links > li {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-width: 0;
  color: var(--ink);
  line-height: 1.4;
}

.panel .member__links > li::before {
  content: none;
}

.member__links svg {
  flex: none;
  width: 1rem;
  height: 1rem;
  fill: var(--muted);
}

.member__links a {
  min-width: 0;
  overflow-wrap: break-word;
  text-decoration: none;
}

.member__links a:hover {
  text-decoration: underline;
}


.footer {
  text-align: center;
  font-size: 0.85rem;
  color: var(--muted);
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
}

.footer__credit {
  font-size: 0.78rem;
}

.footer__social {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-weight: 500;
  text-decoration: none;
}

.footer__social svg {
  width: 1.1rem;
  height: 1.1rem;
  fill: currentColor;
}

/* Too narrow for logo, search and links in one row: links stay beside the logo and the
   search box takes its own row */
@media (max-width: 960px) {
  .nav {
    flex-wrap: wrap;
  }

  .nav__links {
    flex: 1 1 0;
    min-width: 0;
  }

  .nav__search {
    order: 1;
    flex-basis: 100%;
  }

  .nav__search .pagefind-ui__drawer {
    left: 0;
    transform: none;
    width: 100%;
  }
}

@media (max-width: 800px) {
  .faq {
    grid-template-columns: minmax(0, 1fr);
  }

  .faq__index {
    display: none;
  }

  .faq__section {
    padding: 0.25rem 1.25rem;
  }
}

@media (max-width: 600px) {
  .nav__brand {
    font-size: 0;
    gap: 0;
  }

  .hero__actions,
  .block__actions {
    flex-direction: column;
  }
}
  </style>
</head>
<body>
  <nav class="nav" aria-label="Principal">
    <a class="nav__brand" href="/"><img src="/img/icpc-logo.png" alt="" width="48" height="44">ICPC Chile</a>
    <div class="nav__search" id="site-search" role="search"></div>
    <ul class="nav__links">
      <li><a href="/icpc/"{% if page.url == "/icpc/" %} aria-current="page"{% endif %}>ICPC</a></li>
      <li><a href="/tcp/"{% if page.url == "/tcp/" %} aria-current="page"{% endif %}>TCP</a></li>
      <li><a href="/faq/"{% if page.url == "/faq/" %} aria-current="page"{% endif %}>Preguntas frecuentes</a></li>
      <li><a href="/faq/tecnica/"{% if page.url == "/faq/tecnica/" %} aria-current="page"{% endif %}>FAQ técnica</a></li>
      <li><a href="/equipo/"{% if page.url == "/equipo/" %} aria-current="page"{% endif %}>Equipo</a></li>
    </ul>
  </nav>

  <div class="page">
    {%- comment %} Pagefind indexes only this element (see eleventy.config.js) {%- endcomment %}
    <main data-pagefind-body>
{{ content }}
    </main>

    <footer class="footer">
      <p>ICPC Chile{% for contest in contests.upcoming %} · <a href="{{ contest.pageUrl }}">{{ contest.name }}</a>: {{ contest.dates }}{% endfor %}</p>
      <p><a class="footer__social" href="https://www.instagram.com/{{ site.instagram }}/" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-9.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM12 3.8c2.7 0 3 0 4 .1 2.7.1 4 1.4 4.1 4.1.1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.7-1.4 4-4.1 4.1-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1-.1-1.3-.1-4s0-3 .1-4C4 5.3 5.3 4 8 3.9c1-.1 1.3-.1 4-.1ZM12 2c-2.7 0-3.1 0-4.1.1C4.2 2.3 2.3 4.2 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.2 3.7 2.1 5.6 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.7-.2 5.6-2.1 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.2-3.7-2.1-5.6-5.8-5.8C15.1 2 14.7 2 12 2Z"/></svg>@{{ site.instagram }}</a></p>
      <p>© {{ "now" | date: "%Y" }} ICPC Chile</p>
      {% if site.maintainer.show and site.maintainer.name != blank %}<p class="footer__credit">Sitio mantenido por {% if site.maintainer.url != blank %}<a href="{{ site.maintainer.url }}" target="_blank" rel="noreferrer">{{ site.maintainer.name }}</a>{% else %}{{ site.maintainer.name }}{% endif %}{% if site.repository.show %} · <a href="{{ site.repository.url }}" target="_blank" rel="noreferrer">Código fuente</a>{% endif %}</p>{% endif %}
      {% if site.repository.show %}<p class="footer__credit">¿Falta algo o hay un error? <a href="{{ site.repository.url }}/issues/new/choose" target="_blank" rel="noreferrer">Propón un cambio</a>{% unless site.maintainer.show %} · <a href="{{ site.repository.url }}" target="_blank" rel="noreferrer">Código fuente</a>{% endunless %}</p>{% endif %}
    </footer>
  </div>

  <script src="/pagefind/pagefind-ui.js"></script>
  <script>
    const nav = document.querySelector(".nav");
    new ResizeObserver(() => document.documentElement.style.setProperty("--nav-offset", `${nav.offsetHeight}px`)).observe(nav);

    // Site search in the nav; the index is built by eleventy.config.js
    const siteSearch = document.getElementById("site-search");
    if (window.PagefindUI) {
      new PagefindUI({
        element: "#site-search",
        showSubResults: true,
        showImages: false,
        translations: { placeholder: "Buscar" },
      });
      const closeSearch = () => siteSearch.classList.remove("is-open");
      siteSearch.addEventListener("focusin", () => siteSearch.classList.add("is-open"));
      siteSearch.addEventListener("click", (e) => e.target.closest("a") && closeSearch());
      siteSearch.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeSearch();
          document.activeElement.blur();
        }
      });
      document.addEventListener("pointerdown", (e) => siteSearch.contains(e.target) || closeSearch());
    }

    // Open the FAQ answer linked from the URL hash (e.g. #quien-puede-ser-coach)
    function openFromHash() {
      const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      const details = target && target.closest(".faq details");
      if (details) {
        details.open = true;
        target.scrollIntoView();
      }
    }
    window.addEventListener("hashchange", openFromHash);
    openFromHash();

    const countdown = document.getElementById("countdown");
    const countdownElements = {
      days: document.getElementById("days"),
      hours: document.getElementById("hours"),
      minutes: document.getElementById("minutes"),
      seconds: document.getElementById("seconds"),
    };

    const eventDate = countdown && new Date(countdown.dataset.start);
    let timerId;

    function pad(value) {
      return String(value).padStart(2, "0");
    }

    function updateCountdown() {
      const now = new Date();
      const delta = eventDate - now;

      if (delta <= 0) {
        Object.values(countdownElements).forEach((el) => (el.textContent = "00"));
        clearInterval(timerId);
        return;
      }

      const days = Math.floor(delta / (1000 * 60 * 60 * 24));
      const hours = Math.floor((delta / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((delta / (1000 * 60)) % 60);
      const seconds = Math.floor((delta / 1000) % 60);

      countdownElements.days.textContent = pad(days);
      countdownElements.hours.textContent = pad(hours);
      countdownElements.minutes.textContent = pad(minutes);
      countdownElements.seconds.textContent = pad(seconds);
    }

    if (countdown) {
      timerId = setInterval(updateCountdown, 1000);
      updateCountdown();
    }
{%- if bonus.enabled %}
{%- comment %}
    Hidden page (see lib/bonus.js): recognizes the secret key sequence by its hash and
    derives the page URL from the typed keys with a second hash. The prefixes, lengths
    and key normalization must match lib/bonus.js. This comment is not published.
{%- endcomment %}
    const k0 = "{{ bonus.check }}";
    const k1 = [];
    const k2 = async (t) =>
      Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(t))), (b) => b.toString(16).padStart(2, "0")).join("");
    document.addEventListener("keydown", async (e) => {
      if (!window.crypto?.subtle) return;
      k1.push(e.key === " " ? "Space" : e.key.length === 1 ? e.key.toLowerCase() : e.key);
      if (k1.length > {{ bonus.maxKeys }}) k1.shift();
      const r = k1.slice();
      for (let n = {{ bonus.minKeys }}; n <= r.length; n++) {
        const s = r.slice(-n).join(" ");
        if ((await k2("{{ bonus.checkPrefix }}" + s)) === k0) {
          location.href = "/" + (await k2("{{ bonus.pathPrefix }}" + s)).slice(0, {{ bonus.pathLength }}) + "/";
          return;
        }
      }
    });
{%- endif %}
  </script>
</body>
</html>
