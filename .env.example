# Credenciales de producción para `npm run deploy`. Copia este archivo a .env.
# Para `npm run deploy:staging`, crea además un .env.staging con R2_BUCKET,
# R2_ACCESS_KEY_ID y R2_SECRET_ACCESS_KEY de staging: sobrescriben estos valores.
# Ningún archivo .env se sube al repo.
#
# Cloudflare → R2 → Manage R2 API Tokens → token con permiso "Object Read & Write" sobre el bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# URL pública del sitio en producción. Vacío = https://icpc.cl.
SITE_URL=
# URL pública de staging. Vacío = https://staging.icpc.cl.
STAGING_SITE_URL=

# Secuencia de teclas de la página oculta (opcional). Nombres de tecla separados por
# espacios, como en KeyboardEvent.key: flechas "ArrowUp", letras, números y "Space".
# Entre 6 y 24 teclas. Sin este valor, la página oculta no se construye.
EASTER_EGG_KEYS=
