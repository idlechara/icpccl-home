# Credenciales para `npm run deploy` (producción) y `npm run deploy:staging`.
# Copia este archivo a .env. Ningún archivo .env se sube al repo.
# (Opcional: un .env.staging sobrescribe estos valores solo al desplegar a staging,
# por ejemplo si staging usa otro token.)
#
# Cloudflare → R2 → Manage R2 API Tokens → token con permiso "Object Read & Write" sobre el bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_STAGING_BUCKET=

# URL pública del sitio en producción. Vacío = https://icpc.cl.
SITE_URL=
# URL pública de staging. Vacío = https://icpc-cl-staging.idlechara.net.
STAGING_SITE_URL=

# Secuencia de teclas de la página oculta (opcional). Nombres de tecla separados por
# espacios, como en KeyboardEvent.key: flechas "ArrowUp", letras, números y "Space".
# Entre 6 y 24 teclas. Sin este valor, la página oculta no se construye.
EASTER_EGG_KEYS=
